{
  "name": "superdense",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "predev": "pnpm --filter=@nimrobo/superdense-core --filter=@nimrobo/superdense-server run build",
    "dev": "concurrently \"pnpm --filter=@nimrobo/superdense run dev\" \"pnpm --filter=@nimrobo/superdense-web run dev\"",
    "start": "node packages/cli/dist/index.js",
    "release:npm:dry-run": "npm pack --dry-run --workspace packages/cli",
    "release:npm:e2e": "bash packages/cli/e2e/run-e2e.sh",
    "release:npm": "pnpm run release:npm:dry-run && pnpm run release:npm:e2e && npm publish --workspace packages/cli --access public --ignore-scripts",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

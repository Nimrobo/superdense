{
  "name": "superdense",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "predev": "pnpm --filter=@nimrobo/superdense-core --filter=@nimrobo/superdense-server run build",
    "dev": "concurrently \"pnpm --filter=@nimrobo/superdense run dev\" \"pnpm --filter=@nimrobo/superdense-web run dev\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node packages/cli/dist/index.js",
    "release:npm:dry-run": "npm pack --dry-run --workspace packages/cli",
    "release:npm:e2e": "bash packages/cli/e2e/run-e2e.sh",
    "release:npm": "pnpm run release:npm:dry-run && pnpm run release:npm:e2e && pnpm --filter=@nimrobo/superdense run prepare:package && npm publish --workspace packages/cli --access public --ignore-scripts",
    "typecheck": "pnpm --filter=@nimrobo/superdense-core run build && pnpm --filter=@nimrobo/superdense-server run build && pnpm -r --filter=./packages/* run typecheck",
    "test": "pnpm -r run test"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.0",
    "typescript-eslint": "^8.0.0"
  }
}

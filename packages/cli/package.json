{
  "name": "@road42/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "road42": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/skills && cp -r ../../skills dist/skills",
    "dev": "tsx src/index.ts studio --no-open",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@road42/core": "workspace:*",
    "@road42/server": "workspace:*",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "vitest": "^2.1.9",
    "typescript": "^5.5.0"
  }
}

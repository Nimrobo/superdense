{
  "name": "@nimrobo/road42",
  "version": "0.1.0",
  "description": "Road42 — index, inspect, and summarize sessions from your coding agents. The Answer to what your agent was actually doing.",
  "type": "module",
  "bin": {
    "road42": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts studio --no-open",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm --filter=@road42/core --filter=@road42/server --filter=@road42/web run build && node scripts/build.mjs"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@road42/core": "workspace:*",
    "@road42/server": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nimrobo/road42.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agents",
    "sessions",
    "ai",
    "observability",
    "cli"
  ],
  "license": "Apache-2.0"
}

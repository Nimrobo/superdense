{
  "name": "@nimrobo/superdense",
  "version": "0.1.0",
  "description": "Superdense — index, inspect, and summarize sessions from your coding agents.",
  "type": "module",
  "bin": {
    "superdense": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts studio --no-open",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm --filter=@nimrobo/superdense-core --filter=@nimrobo/superdense-server --filter=@nimrobo/superdense-web run build && node scripts/build.mjs"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "open": "^10.1.0",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@nimrobo/superdense-core": "workspace:*",
    "@nimrobo/superdense-server": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimrobo/superdense.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agents",
    "sessions",
    "ai",
    "observability",
    "cli"
  ],
  "license": "Apache-2.0"
}

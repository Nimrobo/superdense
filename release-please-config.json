{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "always-update": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "docs", "section": "Documentation" }
  ],
  "plugins": ["node-workspace"],
  "packages": {
    ".": {
      "package-name": "@nimrobo/superdense",
      "component": "@nimrobo/superdense",
      "extra-files": ["packages/cli/package.json"]
    },
    "packages/core": {
      "package-name": "@nimrobo/superdense-core",
      "skip-github-release": true
    },
    "packages/server": {
      "package-name": "@nimrobo/superdense-server",
      "skip-github-release": true
    },
    "packages/web": {
      "package-name": "@nimrobo/superdense-web",
      "skip-github-release": true
    }
  }
}
